# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Protect POST /api/leaderboard, gallery uploads, and GET /api/teams/:id/full
# In production this MUST be set (server fails closed without it).
ADMIN_API_KEY=change-me-before-deploy

# Persistence lives in ./data/store.json (no Firebase required for local demo)
