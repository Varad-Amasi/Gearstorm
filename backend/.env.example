# Server
PORT=3000
# Comma-separated allowlist for browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
NODE_ENV=development

# Protect gallery uploads and GET /api/teams/:id/full
# In production this MUST be set (server fails closed without it).
ADMIN_API_KEY=change-me-before-deploy

# Persistence lives in ./data/store.json
# On Railway/Fly: mount a volume at /app/data and /app/uploads

# Optional: Google Apps Script web-app URL to append registrations to a Sheet
# GOOGLE_SHEETS_WEBHOOK_URL=
