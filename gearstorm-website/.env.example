# Firebase (public client config — create project at https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API
# Local: /api (Vite proxies to localhost:3000)
# Production: https://<your-api-host>/api
VITE_API_BASE_URL=/api

# Public site origin (no trailing slash) — used for OG tags, sitemap, robots
VITE_SITE_URL=https://gearstorm.example

# Optional monitoring (omit locally)
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# App
VITE_APP_NAME=GearStorm
VITE_APP_VERSION=1.0.0
